{{/* Local override of blox-seo's index.webmanifest. Only change vs. upstream:
     the PWA theme_color/background_color are hardcoded to the navbar navy
     (#2b3a55) instead of the theme primary (#2962ff), to match the theme-color
     meta and keep the installed-app chrome/splash consistent with the site. */}}
{
  "name": "{{site.Title}}",
  "short_name": "{{site.Title}}",
  "lang": "{{ site.LanguageCode | default "en-us" }}",
  "theme_color": "#2b3a55",
  "background_color": "#2b3a55",
  "icons": [{
    "src": "{{ (partial "blox-core/functions/get_icon" 192).RelPermalink }}",
    "sizes": "192x192",
    "type": "image/png"
    }, {
    "src": "{{ (partial "blox-core/functions/get_icon" 512).RelPermalink }}",
    "sizes": "512x512",
    "type": "image/png"
     }],
  "display": "standalone",
  "start_url": "{{ site.Home.RelPermalink }}?utm_source=web_app_manifest"
}
